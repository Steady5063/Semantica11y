{
  "name": "semantica11y",
  "version": "1.0.1",
  "description": "A JavaScript engine to check webpages for ARIA and non-semantic HTML elements with suggestions for improvements",
  "type": "module",
  "main": "./src/index.js",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "Semantically-logo.png"
  ],
  "exports": {
    ".": "./src/index.js",
    "./analyzer": "./src/analyzer.js",
    "./rules": "./src/engine/index.js",
    "./engine": "./src/engine/index.js",
    "./reporter": "./src/engine/reporter/index.js"
  },
  "scripts": {
    "build": "node scripts/build-package.js",
    "pack:dist": "npm run build && npm pack ./dist",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test test/**/*.test.js --watch",
    "lint": "echo 'Add eslint configuration'",
    "example": "node examples/basic.js"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "ARIA",
    "semantic",
    "HTML",
    "web-standards",
    "analyzer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "jsdom": "^24.0.0",
    "semantica11y": "^1.0.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
